{{!
    @template local_backupdownloader/backup_list

    Tables listing the backup files a user can download, one section per area.

    Context variables required for this template:
    * sections - Array of sections: title, hasbackups, backups (rows: filename, size, timemodified, origin, downloadurl), nobackups.
    * intro - Introductory sentence, already HTML-escaped.
    * courseurl - URL of the course home page.

    Example context (json):
    {
        "intro": "Backup files (.mbz) available for \"Introduction\" and in your private backup area.",
        "sections": [
            {
                "title": "Course backup area",
                "hasbackups": true,
                "backups": [
                    {
                        "filename": "backup-moodle2-course-2-intro-20260909-1200.mbz",
                        "size": "12.3 MB",
                        "timemodified": "9 September 2026, 12:00 PM",
                        "origin": "Course backup",
                        "downloadurl": "https://example.com/local/backupdownloader/download.php?id=2&file=42"
                    }
                ],
                "nobackups": "No backup files are available in the course backup area."
            },
            {
                "title": "Private backup area",
                "hasbackups": false,
                "backups": [],
                "nobackups": "No backup files are available in your private backup area."
            }
        ],
        "courseurl": "https://example.com/course/view.php?id=2"
    }
}}
<div class="local-backupdownloader">
    <p class="text-muted">{{{intro}}}</p>

    {{#sections}}
    <h3 class="h4 mt-4">{{title}}</h3>
    {{#hasbackups}}
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">{{title}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} filename, local_backupdownloader {{/str}}</th>
                    <th scope="col">{{#str}} size, local_backupdownloader {{/str}}</th>
                    <th scope="col">{{#str}} lastmodified, local_backupdownloader {{/str}}</th>
                    <th scope="col">{{#str}} origin, local_backupdownloader {{/str}}</th>
                    <th scope="col" class="text-end">{{#str}} actions, local_backupdownloader {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#backups}}
                <tr>
                    <td class="text-break">{{filename}}</td>
                    <td class="text-nowrap">{{size}}</td>
                    <td class="text-nowrap">{{timemodified}}</td>
                    <td>{{origin}}</td>
                    <td class="text-end">
                        <a href="{{downloadurl}}" class="btn btn-primary btn-sm"
                            aria-label="{{#str}} downloadfile, local_backupdownloader, {{filename}} {{/str}}">
                            {{#pix}} t/download, core {{/pix}}
                            {{#str}} download, local_backupdownloader {{/str}}
                        </a>
                    </td>
                </tr>
                {{/backups}}
            </tbody>
        </table>
    </div>
    {{/hasbackups}}
    {{^hasbackups}}
    <div class="alert alert-info" role="alert">{{nobackups}}</div>
    {{/hasbackups}}
    {{/sections}}

    <a href="{{courseurl}}" class="btn btn-secondary mt-3">{{#str}} backtocourse, local_backupdownloader {{/str}}</a>
</div>
